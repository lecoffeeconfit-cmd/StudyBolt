# Secure server endpoint that accepts a private upload and returns a validated StudyPack.
# Never put an AI provider key in the mobile app.
EXPO_PUBLIC_STUDYBOLT_PROCESSOR_URL=

# Supabase Auth project settings. The publishable/anon key is safe for clients;
# never expose the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
