# Self-hosted VPS Edge Function endpoint.
# Never put an AI provider key in the mobile app.
EXPO_PUBLIC_STUDYBOLT_PROCESSOR_URL=https://studybolt-api.duckdns.org/functions/v1/studybolt-process-document

# Supabase Auth project settings. The publishable/anon key is safe for clients;
# never expose the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://kbyeyobbhhnafscygiel.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE

# Public share-link origin. Include the /share path, for example:
# https://your-studybolt-domain.example/share
# Leave blank during local development to use studybolt://share/<token>.
EXPO_PUBLIC_STUDYBOLT_SHARE_BASE_URL=

# RevenueCat public Store SDK keys (public by design). Keep the signing secret
# and entitlement identifier in Supabase Edge Function secrets, never in Expo.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Public legal links. These pages currently contain fields that must be completed.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://lecoffeeconfit-cmd.github.io/studybolt-legal/privacypolicy
EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://lecoffeeconfit-cmd.github.io/studybolt-legal/termsofservice
# Keep false until all policy placeholders are resolved and the final text is approved.
EXPO_PUBLIC_LEGAL_DOCUMENTS_APPROVED=false

# Configure matching URLs and leave approval false until the policy text is complete.
# AI answers, source uploads, and subscription status checks remain paused server-side.
# supabase secrets set STUDYBOLT_PRIVACY_POLICY_URL=https://lecoffeeconfit-cmd.github.io/studybolt-legal/privacypolicy
# supabase secrets set STUDYBOLT_TERMS_OF_SERVICE_URL=https://lecoffeeconfit-cmd.github.io/studybolt-legal/termsofservice
# supabase secrets set STUDYBOLT_LEGAL_DOCUMENTS_APPROVED=false

# AI Tutor secrets are already held by the self-hosted Supabase Edge Function.
# Do not create an Expo variable for OPENAI_API_KEY and do not duplicate the key here.

# Public Sentry client DSN. Safe to include in a client app.
EXPO_PUBLIC_SENTRY_DSN=https://ddd535a77f72186e450cf1e5b4394176@o4511657628008448.ingest.us.sentry.io/4512200025243648

# Sentry source-map upload token is private. Set SENTRY_AUTH_TOKEN as a
# sensitive EAS environment variable for builds; do not commit it here.
