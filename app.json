{
  "expo": {
    "name": "StudyBolt",
    "slug": "studybolt",
    "scheme": "studybolt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.lecoffeeconfit.studybolt",
          "widgets": [
            {
              "name": "StudyFocusWidget",
              "displayName": "Study Focus",
              "description": "See what to study next and how long it may take.",
              "ios": {
                "supportedFamilies": ["systemSmall", "systemMedium"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StudyPlanWidget",
              "displayName": "Today’s Study Plan",
              "description": "Keep today’s next study block in view.",
              "ios": {
                "supportedFamilies": ["systemMedium"],
                "contentMarginsDisabled": true
              }
            },
            {
              "name": "StudyPackWidget",
              "displayName": "Study Pack Progress",
              "description": "See your current Study Pack and available tools.",
              "ios": {
                "supportedFamilies": ["systemLarge"],
                "contentMarginsDisabled": true
              }
            }
          ]
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecoffeeconfit.studybolt",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.studybolt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1D41"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "studyboltProcessorUrl": "https://studybolt-api.duckdns.org/functions/v1/studybolt-process-document",
      "eas": {
        "projectId": "df2b547d-f9a0-47dc-8ea0-586fbfbfd4bb"
      }
    }
  }
}
