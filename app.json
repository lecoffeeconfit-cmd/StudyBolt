{
  "expo": {
    "name": "StudyBolt",
    "slug": "studybolt",
    "scheme": "studybolt",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecoffeeconfit.studybolt",
      "buildNumber": "1"
    },
    "android": {
      "package": "com.studybolt.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F8FF"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
