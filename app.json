{
  "expo": {
    "name": "StudyBolt",
    "slug": "studybolt",
    "scheme": "studybolt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lecoffeeconfit.studybolt",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.studybolt.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B1D41"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "studyboltProcessorUrl": "https://studybolt-api.duckdns.org/functions/v1/studybolt-process-document",
      "eas": {
        "projectId": "df2b547d-f9a0-47dc-8ea0-586fbfbfd4bb"
      }
    }
  }
}
